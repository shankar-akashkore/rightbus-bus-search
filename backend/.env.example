# Copy to backend/.env to override the defaults. This project needs no secrets.
GDS_BASE_URL=http://127.0.0.1:8001
GDS_TIMEOUT_SECONDS=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The supplied dataset is dated 2026-08-09, so past dates are allowed by default.
ALLOW_PAST_DATES=true

# The mock GDS reads its demo knobs from the environment of its own process, e.g.
#   MOCK_GDS_LATENCY_MS=1500 make mock-gds      (slow provider -> loading state)
#   MOCK_GDS_FAIL_MODE=error make mock-gds      (error | timeout | malformed -> error state)
